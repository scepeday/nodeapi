doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= pageTitle
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/css/styles.css')
  body
    .page-shell
      header.hero.small
        h1 Manage Products
        p Add and remove Hidden Thoughts catalog items for the React storefront.

      nav.top-nav
        a.btn-link(href='/admin') Dashboard
        a.btn-link.active(href='/admin/products') Products
        form.inline-form(action='/logout' method='POST')
          button.btn.btn-outline(type='submit') Logout

      main.content.two-col
        section.panel
          h2 Add Product
          form.form-stack(action='/admin/products' method='POST')
            label(for='name') Product Name
            input#name(name='name' type='text' required)

            label(for='description') Description
            textarea#description(name='description' rows='4' required)

            label(for='price') Price (CAD)
            input#price(name='price' type='number' min='0' step='0.01' required)

            label(for='category') Category
            select#category(name='category' required)
              each category in categories
                option(value=category)= category

            label(for='imageUrl') Image URL
            input#imageUrl(name='imageUrl' type='url' required placeholder='https://...')

            label(for='stock') Stock
            input#stock(name='stock' type='number' min='0' step='1' required value='0')

            label.checkbox-row(for='featured')
              input#featured(name='featured' type='checkbox' value='true')
              span Featured product

            button.btn(type='submit') Add Product

        section.panel
          h2 Current Products
          if !products.length
            p.empty No products added yet.

          each product in products
            article.record
              img.record-image(src=product.imageUrl alt=product.name)
              h3= product.name
              p= product.description
              p.meta= `Category: ${product.category}`
              p.meta= `Price: $${product.price.toFixed(2)} CAD`
              p.meta= `Stock: ${product.stock}`
              if product.featured
                p.badge Featured
              form(action=`/admin/products/${product._id}/delete` method='POST')
                button.btn.btn-danger(type='submit') Delete
